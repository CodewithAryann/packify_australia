# Long cache lifetimes for static assets (fixes "Use efficient cache lifetimes").
# Works on Cloudflare Pages and Netlify; harmlessly ignored elsewhere.
# immutable = safe because Next fingerprints filenames on build.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

*.webp
  Cache-Control: public, max-age=31536000, immutable

*.woff2
  Cache-Control: public, max-age=31536000, immutable
